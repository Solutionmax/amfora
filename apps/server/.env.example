# ==============================================================================
# STORAGE
# ==============================================================================
ENABLE_S3=false
DATABASE_URL="file:./amfora.db"

# Files on disk are stored unencrypted unless you turn encryption on and set a key
# of at least 32 characters. Turn it on if the host's disk is not already encrypted.
DISABLE_FILESYSTEM_ENCRYPTION=true
# DISABLE_FILESYSTEM_ENCRYPTION=false
# ENCRYPTION_KEY=

# ==============================================================================
# EXTERNAL S3 COMPATIBLE STORAGE
# ==============================================================================
# ENABLE_S3=true
# S3_ENDPOINT=
# S3_PORT=
# S3_USE_SSL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
# S3_BUCKET_NAME=
# S3_FORCE_PATH_STYLE=          # true for MinIO
# S3_REJECT_UNAUTHORIZED=true   # false only for a self signed certificate
# S3_DISABLE_CHECKSUMS=false    # true for Cloudflare R2, which rejects the default checksum
# PRESIGNED_URL_EXPIRATION=3600

# ==============================================================================
# SECURITY
# ==============================================================================
# Origins allowed to call this API from a browser. Empty means none, which is correct
# when the bundled web app is the only client.
# CORS_ORIGINS=

# Set to false when the API is exposed without a reverse proxy in front of it, so that
# a forged X-Forwarded-For header cannot be used to walk around the rate limits.
# TRUST_PROXY=true

# RATE_LIMIT_MAX=600                # requests per minute per IP, all routes
# RATE_LIMIT_SHARE_PASSWORD=10      # share password attempts per minute per IP
# RATE_LIMIT_CREDENTIALS=10         # login, two factor and reset attempts per minute per IP
# RATE_LIMIT_PUBLIC_UPLOAD=120      # public upload calls per minute per IP

# API_BODY_LIMIT_MB=256             # uploads bypass this; it only bounds JSON and form posts
# API_MULTIPART_LIMIT_MB=32         # logo and avatar uploads
